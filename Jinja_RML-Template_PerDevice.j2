@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eds: <https://w3id.org/omega-x/ontology/EnergyDataSet/> .
@prefix ets: <https://w3id.org/omega-x/ontology/EventTimeSeries/> .
@prefix prop: <https://w3id.org/omega-x/ontology/Property/> .
@prefix role: <https://w3id.org/omega-x/ontology/EnergyRole/> .
@prefix unit: <http://qudt.org/vocab/unit/>.
@prefix qual: <https://w3id.org/omega-x/ontology/Quality/> .

# =========================================================================
# MAPPING 1: The Main EnergyDataSet (Top-level container)
# =========================================================================

<#EnergyDataSetMapping>
    rml:logicalSource [
        rml:source "{{ csv_path }}";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        rr:constant <{{ myprefix }}/EnergyDataSet/{{ device_id }}/{{ wid }}>;
        rr:class eds:EnergyDataSet;
    ];

    # Link to the EvaluationPoint
    rr:predicateObjectMap [
        rr:predicate eds:includesEvaluationPoint;
        rr:objectMap [ rr:constant <{{ myprefix }}/EvaluationPoint/{{ device_id }}>; ];
    ];

    # Link to the ExchangeContext
    rr:predicateObjectMap [
        rr:predicate eds:isExchangedIn;
        rr:objectMap [ rr:constant <{{ myprefix }}/ExchangeContext/{{ wid }}>; ];
    ];

    # This EnergyDataSet comprises one DataCollection for each property
    {% for row in properties %}
    rr:predicateObjectMap [
        rr:predicate ets:comprises;
        rr:objectMap [ rr:constant <{{ myprefix }}/DataCollection/{{ device_id }}/{{ row.property_id }}/{{ wid }}>; ];
    ];
    {% endfor %}
.

# =========================================================================
# MAPPING 2: Static Context Entities
# =========================================================================

<#EvaluationPointMapping>
    rml:logicalSource [ rml:source "{{ csv_path }}"; rml:referenceFormulation ql:CSV; ];
    rr:subjectMap [
        rr:constant <{{ myprefix }}/EvaluationPoint/{{ device_id }}>;
        rr:class eds:EvaluationPoint;
    ].

<#ExchangeContextMapping>
    rml:logicalSource [ rml:source "{{ csv_path }}"; rml:referenceFormulation ql:CSV; ];
    rr:subjectMap [
        rr:constant <{{ myprefix }}/ExchangeContext/{{ wid }}>;
        rr:class eds:ExchangeContext;
    ];
    rr:predicateObjectMap [
        rr:predicate eds:fromSource;
        rr:objectMap [ rr:constant <{{ myprefix }}/MarketParticipant/SourceParticipant>; ];
    ];
    rr:predicateObjectMap [
        rr:predicate eds:toTarget;
        rr:objectMap [ rr:constant <{{ myprefix }}/MarketParticipant/TargetParticipant>; ];
    ].

# =========================================================================
# LOOP: Property-specific DataCollections, DataPoints, and PropertyValues
# =========================================================================

{% for row in properties %}
# -------------------------------------------------------------------------
# DataCollection for Property '{{ row.property_id }}'
# -------------------------------------------------------------------------

<#DataCollectionMapping_{{ row.property_id }}>
    rml:logicalSource [ rml:source "{{ csv_path }}"; rml:referenceFormulation ql:CSV; ];

    rr:subjectMap [
        rr:constant <{{ myprefix }}/DataCollection/{{ device_id }}/{{ row.property_id }}/{{ wid }}>;
        rr:class ets:DataCollection;
    ];

    # Property context
    rr:predicateObjectMap [
        rr:predicate ets:isAboutProperty;
        rr:objectMap [ rr:constant prop:{{ row.property }}; ];
    ];
    rr:predicateObjectMap [
        rr:predicate ets:hasUnit;
        rr:objectMap [ rr:constant unit:{{ row.unit }}; ];
    ];
    rr:predicateObjectMap [
        rr:predicate ets:hasAggregationKind;
        rr:objectMap [ rr:constant ets:{{ row.aggregation_kind }}; ];
    ].

# -------------------------------------------------------------------------
# DataPoint for '{{ row.property_id }}' - ONE MAPPING PER PROPERTY
# -------------------------------------------------------------------------

<#DataPointMapping_{{ row.property_id }}>
    rml:logicalSource [
        rml:source "{{ csv_path }}";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        rr:template "{{ myprefix }}/DataPoint/{{ device_id }}/{{ row.property_id }}/{{ '{' }}{{ timestamp_column }}{{ '}' }}";
        rr:class ets:DataPoint;
    ];

    # Link back to the DataCollection
    rr:predicateObjectMap [
        rr:predicate ets:belongsTo;
        rr:objectMap [
            rr:constant <{{ myprefix }}/DataCollection/{{ device_id }}/{{ row.property_id }}/{{ wid }}>;
        ];
    ];

    # Timestamp for this data point
    rr:predicateObjectMap [
        rr:predicate ets:dataTime;
        rr:objectMap [
            rml:reference "{{ timestamp_column }}";
            rr:datatype xsd:dateTime;
        ];
    ];

    # Link to DataValue instead of direct value
    rr:predicateObjectMap [
        rr:predicate ets:hasDataValue;
        rr:objectMap [
            rr:template "{{ myprefix }}/DataPoint/{{ device_id }}/{{ row.property_id }}/{{ '{' }}{{ timestamp_column }}{{ '}' }}/DV";
        ];
    ].

# -------------------------------------------------------------------------
# DataValue for '{{ row.property_id }}'
# -------------------------------------------------------------------------

<#DataValueMapping_{{ row.property_id }}>
    rml:logicalSource [
        rml:source "{{ csv_path }}";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        rr:template "{{ myprefix }}/DataPoint/{{ device_id }}/{{ row.property_id }}/{{ '{' }}{{ timestamp_column }}{{ '}' }}/DV";
        rr:class ets:DataValue;
    ];

    # The actual data value with condition to avoid NULL/empty values
    rr:predicateObjectMap [
        rr:predicate ets:value;
        rr:objectMap [
            rml:reference "{{ row.csv_column }}";
            rr:condition "[{{ row.csv_column }} != 'NULL' && {{ row.csv_column }} != '']";
            rr:datatype xsd:double;
        ];
    ].
{% endfor %}
