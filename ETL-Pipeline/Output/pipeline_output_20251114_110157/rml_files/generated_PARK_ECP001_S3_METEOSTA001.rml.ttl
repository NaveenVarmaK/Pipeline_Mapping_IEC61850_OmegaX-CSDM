@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eds: <https://w3id.org/omega-x/ontology/EnergyDataSet/> .
@prefix ets: <https://w3id.org/omega-x/ontology/EventTimeSeries/> .
@prefix prop: <https://w3id.org/omega-x/ontology/Property/> .
@prefix role: <https://w3id.org/omega-x/ontology/EnergyRole/> .
@prefix unit: <http://qudt.org/vocab/unit/>.
@prefix qual: <https://w3id.org/omega-x/ontology/Quality/> .

# =========================================================================
# MAPPING 1: The Main EnergyDataSet (Top-level container)
# =========================================================================

<#EnergyDataSetMapping>
    rml:logicalSource [
        rml:source "/home/naveen/PycharmProjects/Pipeline_Mapping_IEC61850_OmegaX-CSDM/Pipeline_Mapping_IEC61850_OmegaX-CSDM/cleaned-repo/ETL-Pipeline/Output/pipeline_output_20251114_110157/split_csvs/PARK_ECP001_S3_METEOSTA001.csv";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/EnergyDataSet/PARK_ECP001_S3_METEOSTA001/W1>;
        rr:class eds:EnergyDataSet;
    ];

    # Link to the EvaluationPoint
    rr:predicateObjectMap [
        rr:predicate eds:includesEvaluationPoint;
        rr:objectMap [ rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/EvaluationPoint/PARK_ECP001_S3_METEOSTA001>; ];
    ];

    

    # This EnergyDataSet comprises one DataCollection for each property
    
    rr:predicateObjectMap [
        rr:predicate ets:comprises;
        rr:objectMap [ rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataCollection/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/W1>; ];
    ];
    
    rr:predicateObjectMap [
        rr:predicate ets:comprises;
        rr:objectMap [ rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataCollection/PARK_ECP001_S3_METEOSTA001/s4PVSTMPTmpmagf/W1>; ];
    ];
    
.

# =========================================================================
# MAPPING 2: Static Context Entities
# =========================================================================

<#EvaluationPointMapping>
    rml:logicalSource [
        rml:source "/home/naveen/PycharmProjects/Pipeline_Mapping_IEC61850_OmegaX-CSDM/Pipeline_Mapping_IEC61850_OmegaX-CSDM/cleaned-repo/ETL-Pipeline/Output/pipeline_output_20251114_110157/split_csvs/PARK_ECP001_S3_METEOSTA001.csv";
        rml:referenceFormulation ql:CSV;
    ];
    rr:subjectMap [
        rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/EvaluationPoint/PARK_ECP001_S3_METEOSTA001>;
        rr:class eds:EvaluationPoint;
    ];
.



# =========================================================================
# LOOP: Property-specific DataCollections, DataPoints, and PropertyValues
# =========================================================================


# -------------------------------------------------------------------------
# DataCollection for Property 's4MMETPOAInsol1magf'
# -------------------------------------------------------------------------

<#DataCollectionMapping_s4MMETPOAInsol1magf>
    rml:logicalSource [
        rml:source "/home/naveen/PycharmProjects/Pipeline_Mapping_IEC61850_OmegaX-CSDM/Pipeline_Mapping_IEC61850_OmegaX-CSDM/cleaned-repo/ETL-Pipeline/Output/pipeline_output_20251114_110157/split_csvs/PARK_ECP001_S3_METEOSTA001.csv";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataCollection/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/W1>;
        rr:class ets:DataCollection;
    ];

    # Property context
    rr:predicateObjectMap [
        rr:predicate ets:isAboutProperty;
        rr:objectMap [ rr:constant prop:PlaneOfArrayIrradiance; ];
    ];
    rr:predicateObjectMap [
        rr:predicate ets:hasUnit;
        rr:objectMap [ rr:constant unit:W-PER-M2; ];
    ];
    
    rr:predicateObjectMap [
        rr:predicate ets:hasAggregationKind;
        rr:objectMap [ rr:constant qual:Average; ];
    ];
    
.

# -------------------------------------------------------------------------
# DataPoint for 's4MMETPOAInsol1magf' - ONE MAPPING PER PROPERTY
# -------------------------------------------------------------------------

<#DataPointMapping_s4MMETPOAInsol1magf>
    rml:logicalSource [
        rml:source "/home/naveen/PycharmProjects/Pipeline_Mapping_IEC61850_OmegaX-CSDM/Pipeline_Mapping_IEC61850_OmegaX-CSDM/cleaned-repo/ETL-Pipeline/Output/pipeline_output_20251114_110157/split_csvs/PARK_ECP001_S3_METEOSTA001.csv";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        # MODIFIED: Use the sanitized timestamp column for the IRI
        rr:template "https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataPoint/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/{sanitized_timestamp_for_iri}";
        rr:class ets:DataPoint;
    ];

    # Link back to the DataCollection
    rr:predicateObjectMap [
        rr:predicate ets:belongsTo;
        rr:objectMap [
            rr:constant <https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataCollection/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/W1>;
        ];
    ];

    # Timestamp for this data point
    # UNCHANGED: Use the original timestamp column for the literal value
    rr:predicateObjectMap [
        rr:predicate ets:dataTime;
        rr:objectMap [
            rml:reference "Time";
            rr:datatype xsd:dateTime;
        ];
    ];

    # Link to DataValue instead of direct value
    rr:predicateObjectMap [
        rr:predicate ets:hasDataValue;
        rr:objectMap [
             # MODIFIED: Use the sanitized timestamp column for the IRI
            rr:template "https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataPoint/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/{sanitized_timestamp_for_iri}/DV";
        ];
    ];
.

# -------------------------------------------------------------------------
# DataValue for 's4MMETPOAInsol1magf'
# -------------------------------------------------------------------------

<#DataValueMapping_s4MMETPOAInsol1magf>
    rml:logicalSource [
        rml:source "/home/naveen/PycharmProjects/Pipeline_Mapping_IEC61850_OmegaX-CSDM/Pipeline_Mapping_IEC61850_OmegaX-CSDM/cleaned-repo/ETL-Pipeline/Output/pipeline_output_20251114_110157/split_csvs/PARK_ECP001_S3_METEOSTA001.csv";
        rml:referenceFormulation ql:CSV;
    ];

    rr:subjectMap [
        # MODIFIED: Use the sanitized timestamp column for the IRI
        rr:template "https://w3id.org/omega-x/ontology/KG/PARKMeteostationDataSets/DataPoint/PARK_ECP001_S3_METEOSTA001/s4MMETPOAInsol1magf/{sanitized_timestamp_for_iri}/DV";
        rr:class ets:DataValue;
    ];

    # The actual data value with condition to avoid NULL/empty values
    rr:predicateObjectMap [
        rr:predicate ets:value;
        rr:objectMap [
            rml:reference "s4MMET.POAInsol1.mag.f";
            rr:datatype xsd:double;
        ];
    ];
.

